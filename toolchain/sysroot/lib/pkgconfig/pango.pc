prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: Pango
Description: Internationalized text handling
Version: 1.56.4
Requires: glib-2.0 >=  2.82, gobject-2.0 >=  2.82, gio-2.0 >=  2.82, fribidi >=  1.0.6, harfbuzz >=  8.4.0, fontconfig >=  2.15.0, freetype2, cairo >=  1.18.0
Libs: -L${libdir} -lpango-1.0 -lm
Cflags: -I${includedir}/pango-1.0
