# GTK 3 Build Override for OXIDE OS
# — NeonVale: "The widget toolkit. Buttons, windows, menus, text entries — everything
# a desktop app draws comes from here. We build the Wayland backend only."
#
# This is the summit of the dependency chain. If this builds, we win.

BUILD_SYSTEM="meson"

CONFIGURE_FLAGS="
  -Dwayland_backend=true
  -Dx11_backend=false
  -Dbroadway_backend=false
  -Dwin32_backend=false
  -Dquartz_backend=false
  -Dcloudproviders=false
  -Dprofiler=false
  -Dtracker3=false
  -Dcolord=no
  -Dgtk_doc=false
  -Dman=false
  -Dintrospection=false
  -Dinstalled_tests=false
  -Dtests=false
  -Ddemos=false
  -Dexamples=false
  -Dprint_backends=file
"

EXTRA_CFLAGS="-DOXIDE_OS"

post_configure() {
    echo "  -> GTK3 configured for Wayland-only on OXIDE OS"
}

post_build() {
    echo "============================================"
    echo "  GTK 3 BUILT FOR OXIDE OS"
    echo "  — NeonVale: The neon grid awakens."
    echo "============================================"
}
