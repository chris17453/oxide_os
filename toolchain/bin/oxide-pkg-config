#!/usr/bin/env bash
#
# OXIDE pkg-config Wrapper
#
# — PulseForge: Uses the host system's pkg-config but pointed at our sysroot's
# .pc files. This way we get real version detection, proper -I/-L flags, and
# dependency chain resolution — all reading from our cross-compiled packages.
#
# The old version was a stub that returned 0.1.0 for everything. That broke
# meson's dependency version checks (freetype >= 12.0.6 etc.)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLCHAIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SYSROOT="$TOOLCHAIN_ROOT/sysroot"

export PKG_CONFIG_PATH="$SYSROOT/lib/pkgconfig"
export PKG_CONFIG_LIBDIR="$SYSROOT/lib/pkgconfig"
export PKG_CONFIG_SYSROOT_DIR="$SYSROOT"

# Use the host's pkg-config with sysroot variables
exec pkg-config "$@"
